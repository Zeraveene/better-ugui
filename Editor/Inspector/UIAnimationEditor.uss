.ui-animation-inspector {
    padding-top: 4px;
}

.animation-channel {
    margin-top: 8px;
    margin-bottom: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 5px;
}

.channel-header {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    background-color: rgba(128, 128, 128, 0.12);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.channel-foldout {
    flex-grow: 1;
    -unity-font-style: bold;
}

.channel-enabled {
    flex-shrink: 0;
    margin-left: 8px;
}

.channel-enabled > .unity-base-field__label {
    min-width: 0;
    margin-right: 5px;
}

.channel-content {
    padding: 6px 8px 8px;
}

.animation-hint {
    margin: 8px 3px 4px;
    opacity: 0.7;
}

.playback-controls {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.playback-controls > Button {
    flex-grow: 1;
    min-height: 24px;
}

.ui-animation-inspector .hidden {
    display: none;
}
